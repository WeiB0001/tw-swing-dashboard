          <div class="mom-list ok">已確認：{{ r.momentum_hits|join('、') }}</div>
          {% endif %}
          {% if r.momentum_warns %}
          <div class="mom-list bad">風險：{{ r.momentum_warns|join('、') }}</div>
          {% endif %}
          <div class="mom-note">
            動能用當日價量作風險篩選，並納入相同規則的回測重播。
            今日漲幅超過 {{ mom_high }}% 不再加分，避免變成追高。
          </div>
        </div>
        {% endif %}

        {% if r.overseas_label %}
        <details class="fold fold-inline"><summary>海外研究 <small>{{ r.overseas_label }} · 不影響主排名</small></summary>
          <p class="research-note">{% if r.overseas_rank %}研究名次 {{ r.overseas_rank }}，綜合分數 {{ r.overseas_hist_score }}；{{ '採海外分組統計' if r.overseas_hist_source == 'overseas' else '海外條件樣本不足，回退原統計' }}。{% else %}缺少完整海外行情或成熟統計，暫無研究名次。{% endif %}</p>
          {% if r.overseas_context %}<p class="research-note">{{ r.overseas_context.basis }}。使用美股日期：{% for key,date in r.overseas_context.dates.items() %}{{ key }} {{ date }}{{ '；' if not loop.last }}{% endfor %}</p>{% endif %}
        </details>
        {% endif %}
        {% if r.overseas_note %}
        <div class="ov">🌐 {{ r.overseas_note }}</div>
        {% endif %}

        {% if r.nextday %}
        <div class="nd">
          <div class="nd-head">歷史上同樣條件的股票，隔天買、持有 {{ hold_days }} 天賣的結果
            <span class="sub">（{{ r.nextday_source }}，{{ r.nextday.samples }} 筆）</span></div>
